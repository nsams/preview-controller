# Defaults for the preview controller. Override locally in .env.local, secrets go to .env.secrets.

# Port the controller listens on - the only published port of the whole setup
PREVIEW_CONTROLLER_PORT=9000

# Previews live on <slug>.<base domain>, the controller itself on the base domain.
# *.localhost resolves to 127.0.0.1 in all current browsers.
PREVIEW_CONTROLLER_BASE_DOMAIN=preview.localhost

# http or https - https only makes sense behind a proxy that terminates tls
PREVIEW_CONTROLLER_SCHEME=http

# oauth2-proxy, which every request is checked against - see oauth2-proxy/. For local development
# without it, set PREVIEW_CONTROLLER_AUTH_DISABLED=true in .env.local instead; the controller then
# only listens on 127.0.0.1.
PREVIEW_CONTROLLER_OAUTH2_PROXY_URL=http://127.0.0.1:4180

# Stop a preview after this many minutes without a request
PREVIEW_CONTROLLER_IDLE_TIMEOUT_MINUTES=60

# Delete a preview that has been stopped this long, including its images, volumes and
# checkout. 0 switches the cleanup off.
PREVIEW_CONTROLLER_REMOVE_AFTER_DAYS=7

# Range the per-preview ports are taken from
PREVIEW_CONTROLLER_PORT_RANGE=31000-31099

# Checkouts and logs
PREVIEW_CONTROLLER_DATA_DIR=./data
