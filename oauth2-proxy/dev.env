# Local authentication: dev-oidc-provider with the users of dev-oidc-provider.config.mts, and
# oauth2-proxy with oauth2-proxy.cfg on top of these values. Read by `npm run dev:auth-provider`
# and `npm run dev:auth-proxy` only, never by the controller: whatever it has in its environment
# is passed on to the start scripts of the previews, whose projects may have an oauth2-proxy too.

# Downloaded by `npm run setup:download-oauth2-proxy`. Keep it in line with compose.yml.
OAUTH2_PROXY_VERSION=v7.15.5

IDP_PORT=8080
IDP_CLIENT_ID=preview-controller
IDP_CLIENT_SECRET=dev-oidc-secret

# Where PREVIEW_CONTROLLER_OAUTH2_PROXY_URL in ../.env points to
OAUTH2_PROXY_HTTP_ADDRESS=127.0.0.1:4180
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=http://localhost:${IDP_PORT}
OAUTH2_PROXY_CLIENT_ID=${IDP_CLIENT_ID}
OAUTH2_PROXY_CLIENT_SECRET=${IDP_CLIENT_SECRET}
OAUTH2_PROXY_SCOPE=openid email profile
OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256
# The user is picked again on every sign-in, so that signing out (/__oauth2/sign_out) is enough
# to switch to another one - otherwise the provider would remember the last.
OAUTH2_PROXY_PROMPT=login
OAUTH2_PROXY_REDIRECT_URL=http://preview.localhost:9000/__oauth2/callback
OAUTH2_PROXY_COOKIE_DOMAINS=.preview.localhost
OAUTH2_PROXY_WHITELIST_DOMAINS=.preview.localhost:9000
OAUTH2_PROXY_COOKIE_SECURE=false
# Only ever used locally. Fixed, so that a restart of oauth2-proxy keeps you signed in.
OAUTH2_PROXY_COOKIE_SECRET=local-development-cookie-secret!
