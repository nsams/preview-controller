{
    "name": "preview-controller",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build --config frontend/vite.config.ts",
        "dev": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.secrets src/index.ts",
        "dev:frontend": "vite --config frontend/vite.config.ts",
        "lint": "run-p -l lint:{eslint,knip,prettier,tsc,tsc-frontend}",
        "lint:eslint": "eslint --max-warnings 0 .",
        "lint:fix": "run-s lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "npm run lint:eslint -- --fix",
        "lint:fix:prettier": "npx prettier --write .",
        "lint:knip": "knip --exports --files --dependencies --tags=-knipignore",
        "lint:prettier": "npx prettier --check .",
        "lint:tsc": "tsc --noEmit",
        "lint:tsc-frontend": "tsc --noEmit -p frontend && tsc --noEmit -p frontend/tsconfig.node.json",
        "prepare": "husky",
        "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.secrets src/index.ts",
        "test": "node --test 'src/**/*.test.ts'",
        "test:e2e": "npm run build && playwright test"
    },
    "dependencies": {
        "@apollo/client": "^3.14.1",
        "@dextinity/admin": "10.8.0",
        "@dextinity/admin-icons": "10.8.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource-variable/roboto-flex": "^5.3.0",
        "@hono/node-server": "^1.15.0",
        "@mui/material": "^7.3.11",
        "@mui/x-data-grid": "^8.29.3",
        "@mui/x-date-pickers": "^8.29.3",
        "final-form": "^4.20.10",
        "graphql": "^16.14.2",
        "history": "^4.10.1",
        "hono": "^4.7.0",
        "react": "^19.3.0",
        "react-dnd": "^16.0.1",
        "react-dom": "^19.3.0",
        "react-final-form": "^6.5.9",
        "react-intl": "^7.1.14",
        "react-router": "^5.3.4",
        "react-router-dom": "^5.3.4"
    },
    "devDependencies": {
        "@dextinity/eslint-config": "10.8.0",
        "@playwright/test": "^1.63.0",
        "@types/node": "^24.13.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-router": "^5.1.20",
        "@types/react-router-dom": "^5.3.3",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^9.39.5",
        "husky": "^9.1.7",
        "knip": "^6.39.0",
        "lint-staged": "^17.6.0",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.8",
        "typescript": "^5.9.3",
        "vite": "^8.3.2"
    },
    "engines": {
        "node": "24"
    },
    "overrides": {
        "react-final-form": {
            "react": "^19.3.0"
        },
        "react-final-form-arrays": {
            "react": "^19.3.0"
        }
    }
}
